generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id               Int       @id @default(autoincrement())
  name             String
  slug             String    @unique
  shortName        String
  logo             String?
  primaryColor     String
  secondaryColor   String
  heroTitle        String
  heroText         String
  portalPassword   String
  printfulTokenEnv String?
  portalEnabled    Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products         Product[]
  catalogItems     CatalogItem[]
  collections      Collection[]
  packages         Package[]
  assets           BrandAsset[]
  requests         MarketingRequest[]
  orders           Order[]
  projects         Project[]
  companyServices  CompanyService[]
}

model Service {
  id                Int              @id @default(autoincrement())
  slug              String           @unique
  name              String
  description       String
  category          String?          @default("creative")
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  estimatedDuration String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  fields            ServiceField[]
  companies         CompanyService[]

  @@index([active, sortOrder])
}

model ServiceField {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  key         String
  label       String
  type        String
  placeholder String?
  helpText    String?
  required    Boolean  @default(false)
  wide        Boolean  @default(false)
  options     Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@index([serviceId, sortOrder])
}

model CompanyService {
  id             Int      @id @default(autoincrement())
  companyId      Int
  serviceId      Int
  enabled        Boolean  @default(true)
  featured       Boolean  @default(false)
  customPrice    Float?
  customTimeline String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([companyId, serviceId])
  @@index([companyId, enabled, sortOrder])
}

model Product {
  id           Int      @id @default(autoincrement())
  companyId    Int
  printfulId   String
  name         String
  thumbnail    String?
  price        Float?
  collection   String?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  catalogItem  CatalogItem?
  packageItems PackageItem[]

  @@unique([companyId, printfulId])
}

model CatalogItem {
  id              Int      @id @default(autoincrement())
  companyId       Int
  collectionId    Int?
  productId       Int?     @unique
  itemType        String   @default("product")
  sourceVendor    String?
  sourceProductId String?
  title           String
  description     String?
  thumbnail       String?
  price           Float?
  sku             String?
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company     @relation(fields: [companyId], references: [id])
  collection      Collection? @relation(fields: [collectionId], references: [id])
  product         Product?    @relation(fields: [productId], references: [id])
  packageItems    PackageItem[]

  @@unique([companyId, sourceVendor, sourceProductId])
  @@index([companyId, itemType])
  @@index([companyId, collectionId])
}

model Collection {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  slug        String
  description String?
  heroImage   String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  company      Company       @relation(fields: [companyId], references: [id])
  catalogItems CatalogItem[]

  @@unique([companyId, slug])
}

model Package {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  description String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  company     Company  @relation(fields: [companyId], references: [id])
  items       PackageItem[]
  projects    Project[]
}

model PackageItem {
  id            Int     @id @default(autoincrement())
  packageId     Int
  productId     Int?
  catalogItemId Int?
  quantity      Int     @default(1)

  package       Package      @relation(fields: [packageId], references: [id])
  product       Product?     @relation(fields: [productId], references: [id])
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  @@unique([packageId, productId])
  @@unique([packageId, catalogItemId])
}

model BrandAsset {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  category    String
  fileUrl     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])
}

model MarketingRequest {
  id          Int      @id @default(autoincrement())
  companyId   Int
  type        String
  title       String
  description String?
  priority    String   @default("normal")
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  project     Project?
}

model Project {
  id            Int      @id @default(autoincrement())
  companyId     Int
  requestId     Int?     @unique
  packageId     Int?
  title         String
  description   String?
  status        String   @default("new")
  priority      String   @default("normal")
  startDate     DateTime?
  dueDate       DateTime?
  budget        Float?
  internalCost  Float?
  clientVisible Boolean  @default(true)
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id])
  request       MarketingRequest? @relation(fields: [requestId], references: [id])
  package       Package?          @relation(fields: [packageId], references: [id])
  tasks         ProjectTask[]
  notes         ProjectNote[]
  activities    ProjectActivity[]

  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model ProjectTask {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("normal")
  assignedTo  String?
  dueDate     DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ProjectNote {
  id         Int      @id @default(autoincrement())
  projectId  Int
  body       String
  visibility String   @default("internal")
  author     String?
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectActivity {
  id        Int      @id @default(autoincrement())
  projectId Int
  type      String
  message   String
  actor     String?
  metadata  String?
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Order {
  id              Int      @id @default(autoincrement())
  companyId       Int
  stripeSessionId String?
  printfulOrderId String?
  status          String   @default("pending")
  total           Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id])
}
